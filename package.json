    "online": "node tools/online.js"
  },
  "dependencies": {
    "@colyseus/core": "0.18.30",
    "@colyseus/schema": "5.0.51",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/ws-transport": "0.18.5",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
