--- /dev/null
+++ b/src/client/gfx/hero.js
@@ -0,0 +1,43 @@
+// Hero prototype textures: 'hero' spritesheet (walk/idle/blink/hurt per direction,
+// roll0..3) and a bigger slingshot with rest / pulled frames.
+import { heroFrame, heroRollBall, rotateGrid } from '../../shared/art/hero.js';
+import { addOutline, createSpritesheet, gridFromStrings } from '../art/pixelArt.js';
+import { PALETTE as P } from '../art/palette.js';
+
+const O = '#1a1212';
+
+const SLING_REST = [
+  '......WWw.',
+  '.......WB.',
+  'hhhwWWW.B.',
+  'hhhwWWW.L.',
+  '.......WB.',
+  '......WWw.',
+];
+const SLING_PULL = [
+  '......WWw.',
+  '.....BBW..',
+  'hhhwLWW...',
+  'hhhwWWW...',
+  '.....BBW..',
+  '......WWw.',
+];
+
+export function createHeroTextures(scene, traits = {}) {
+  if (scene.textures.exists('hero')) return;
+  const frames = [];
+  for (const dir of ['down', 'up', 'side']) {
+    for (let i = 0; i < 4; i++) frames.push({ name: `${dir}_walk${i}`, grid: addOutline(heroFrame(traits, dir, { walk: i, tail: i % 2 }), O) });
+    for (let i = 0; i < 2; i++) frames.push({ name: `${dir}_idle${i}`, grid: addOutline(heroFrame(traits, dir, { idle: i, tail: i }), O) });
+    frames.push({ name: `${dir}_blink`, grid: addOutline(heroFrame(traits, dir, { blink: true }), O) });
+    frames.push({ name: `${dir}_hurt`, grid: addOutline(heroFrame(traits, dir, { hurt: true }), O) });
+  }
+  createSpritesheet(scene, 'hero', frames);
+  const ball = heroRollBall(traits);
+  createSpritesheet(scene, 'heroRoll', [0, 1, 2, 3].map((k) => ({ name: String(k), grid: addOutline(rotateGrid(ball, k), O) })));
+  const colors = { W: P.wood, w: P.woodDark, B: P.band, L: '#8a5a3a', h: '#c88a50' };
+  createSpritesheet(scene, 'sling2', [
+    { name: 'rest', grid: addOutline(gridFromStrings(SLING_REST, colors), O) },
+    { name: 'pull', grid: addOutline(gridFromStrings(SLING_PULL, colors), O) },
+  ]);
+}
diff --git a/src/client/gfx/juice.js b/src/client/gfx/juice.js
new file mode 100644
index 0000000..20a9731
--- /dev/null
+++ b/src/client/gfx/juice.js
@@ -0,0 +1,158 @@
+// Upgrade 4 - combat juice and persistent debris: enemies burst into chunks that
+// arc, bounce and stay on the ground (Gungeon-style), scorch marks after
+// explosions, death "poof" rings, footprints in the sand.
+import { DEPTH } from '../systems/depth.js';
+import { hash2 } from './noise.js';
+
+const CHUNKS = {
+  crab: ['#e2553a', '#ff9b70', '#b8341f', '#ffffff'],
+  coconut: ['#7a4a26', '#a06a3c', '#f2ead8', '#5a3216'],
+  skeleton: ['#f2ead8', '#c9bfa8', '#2b2420', '#f2ead8'],
+  tiki: ['#b0703a', '#5a9a48', '#ffcf3a', '#6e3d1a'],
+  crabKing: ['#e2553a', '#f0c040', '#ffffff', '#b8341f'],
+};
+const STAIN = { crab: '#c9a06a', coconut: '#f7eed8', skeleton: '#cbb48a', tiki: '#c39a62', crabKing: '#c9a06a' };
+
+function ensureTextures(scene) {
+  if (scene.textures.exists('chunk2')) return;
+  for (const [k, w, h] of [['chunk2', 2, 2], ['chunk3', 3, 2], ['chunk1', 1, 1]]) {
+    const t = scene.textures.createCanvas(k, w, h);
+    const ctx = t.getContext();
+    ctx.fillStyle = '#ffffff';
+    ctx.fillRect(0, 0, w, h);
+    t.refresh();
+  }
+  // irregular stain blob (white, tinted when stamped)
+  {
+    const t = scene.textures.createCanvas('stain', 14, 8);
+    const ctx = t.getContext();
+    ctx.fillStyle = '#ffffff';
+    for (let y = 0; y < 8; y++) for (let x = 0; x < 14; x++) {
+      const d = ((x - 6.5) / 7) ** 2 + ((y - 3.5) / 4) ** 2;
+      if (d < 0.55 || (d < 1 && hash2(x, y, 9) < 0.45)) ctx.fillRect(x, y, 1, 1);
+    }
+    t.refresh();
+  }
+  {
+    const t = scene.textures.createCanvas('scorch', 40, 24);
+    const ctx = t.getContext();
+    for (let y = 0; y < 24; y++) for (let x = 0; x < 40; x++) {
+      const ang = Math.atan2((y - 11.5) * 1.6, x - 19.5);
+      const jag = 0.75 + 0.25 * Math.sin(ang * 7) + (hash2(Math.round(ang * 9), 0, 4) - 0.5) * 0.2;
+      const d = Math.sqrt(((x - 19.5) / 20) ** 2 + ((y - 11.5) / 12) ** 2) / jag;
+      if (d > 1) continue;
+      ctx.fillStyle = d < 0.45 ? 'rgba(40,22,14,0.75)' : d < 0.8 ? 'rgba(70,40,20,0.55)' : 'rgba(110,70,35,0.4)';
+      ctx.fillRect(x, y, 1, 1);
+    }
+    t.refresh();
+  }
+  {
+    const t = scene.textures.createCanvas('footprint', 2, 2);
+    const ctx = t.getContext();
+    ctx.fillStyle = 'rgba(150,110,60,0.55)';
+    ctx.fillRect(0, 0, 2, 2);
+    t.refresh();
+  }
+}
+
+export class Juice {
+  constructor(scene, map, localPlayerId) {
+    this.scene = scene;
+    this.localPlayerId = localPlayerId;
+    ensureTextures(scene);
+    const W = map.width * map.tileSize;
+    const H = map.height * map.tileSize;
+    this.decals = scene.add.renderTexture(0, 0, W, H).setOrigin(0).setDepth(DEPTH.SHADOW - 20);
+    this.stamp = scene.make.image({ x: 0, y: 0, key: 'chunk2', add: false });
+    this.chunks = [];
+    this.pool = [];
+    this.rings = [];
+    this.n = 0;
+    this.lastFoot = null;
+    this.footSide = 1;
+    this.footprints = [];
+  }
+
+  rand() {
+    this.n++;
+    return hash2(this.n, 17, 5);
+  }
+
+  handle(events) {
+    for (const e of events) {
+      if (e.type === 'enemyDied') this.burst(e);
+      else if (e.type === 'explosion') this.drawDecal('scorch', e.x, e.y, 0xffffff, Math.min(0.7, e.radius / 40), 0.85);
+    }
+  }
+
+  drawDecal(key, x, y, tint, scale = 1, alpha = 1, angle = 0) {
+    this.stamp.setTexture(key).setTint(tint).setScale(scale).setAlpha(alpha).setAngle(angle).setOrigin(0.5);
+    this.decals.draw(this.stamp, Math.round(x), Math.round(y));
+  }
+
+  burst(e) {
+    const colors = CHUNKS[e.enemyType] ?? CHUNKS.crab;
+    const n = e.boss ? 30 : 5;
+    this.drawDecal('stain', e.x, e.y + 1, parseInt((STAIN[e.enemyType] ?? '#c9a06a').slice(1), 16), e.boss ? 2.4 : 0.8, 0.4);
+    for (let i = 0; i < n; i++) {
+      const c = this.pool.pop() ?? this.scene.add.image(0, 0, 'chunk2');
+      const r = this.rand();
+      c.setTexture(r < 0.3 ? 'chunk3' : r < 0.8 ? 'chunk2' : 'chunk1')
+        .setTint(parseInt(colors[i % colors.length].slice(1), 16)).setVisible(true).setAlpha(1);
+      const a = this.rand() * Math.PI * 2;
+      const sp = (e.boss ? 60 : 30) + this.rand() * 60;
+      this.chunks.push({ img: c, x: e.x, y: e.y, z: 6, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp * 0.6, vz: 60 + this.rand() * 90, bounces: 0 });
+    }
+    // white death poof
+    const ring = this.rings.pop() ?? this.scene.add.image(0, 0, 'ring').setDepth(DEPTH.FX);
+    ring.setPosition(Math.round(e.x), Math.round(e.y - 6)).setVisible(true).setAlpha(0.9).setScale(0.15).setTint(0xffffff);
+    this.scene.tweens.add({
+      targets: ring, scale: e.boss ? 2 : 0.7, alpha: 0, duration: 220, ease: 'Quad.Out',
+      onComplete: () => { ring.setVisible(false); this.rings.push(ring); },
+    });
+  }
+
+  update(dt, player) {
+    const g = 420;
+    for (let i = this.chunks.length - 1; i >= 0; i--) {
+      const c = this.chunks[i];
+      c.vz -= g * dt;
+      c.x += c.vx * dt;
+      c.y += c.vy * dt;
+      c.z += c.vz * dt;
+      if (c.z <= 0) {
+        c.z = 0;
+        c.bounces++;
+        c.vz = -c.vz * 0.35;
+        c.vx *= 0.5;
+        c.vy *= 0.5;
+        if (c.bounces >= 2) {
+          this.decals.draw(c.img.setPosition(Math.round(c.x), Math.round(c.y)), Math.round(c.x), Math.round(c.y));
+          c.img.setVisible(false);
+          this.pool.push(c.img);
+          this.chunks.splice(i, 1);
+          continue;
+        }
+      }
+      c.img.setPosition(Math.round(c.x), Math.round(c.y - c.z)).setDepth(c.y);
+    }
+
+    // Footprints in the sand
+    if (player && player.alive && !player.rolling) {
+      const p = { x: player.x, y: player.y };
+      if (!this.lastFoot) this.lastFoot = p;
+      const dx = p.x - this.lastFoot.x;
+      const dy = p.y - this.lastFoot.y;
+      const d = Math.hypot(dx, dy);
+      if (d > 7) {
+        this.footSide *= -1;
+        const nx = (-dy / d) * 2 * this.footSide;
+        const ny = (dx / d) * 2 * this.footSide;
+        const f = this.footprints.pop() ?? this.scene.add.image(0, 0, 'footprint').setDepth(DEPTH.SHADOW - 5);
+        f.setPosition(Math.round(p.x + nx), Math.round(p.y + 3 + ny)).setAlpha(1).setVisible(true);
+        this.scene.tweens.add({ targets: f, alpha: 0, delay: 1200, duration: 1600, onComplete: () => { f.setVisible(false); this.footprints.push(f); } });
+        this.lastFoot = p;
+      }
+    } else if (player) this.lastFoot = { x: player.x, y: player.y };
+  }
+}
diff --git a/src/client/gfx/lighting.js b/src/client/gfx/lighting.js
new file mode 100644
index 0000000..b6f6e6e
--- /dev/null
+++ b/src/client/gfx/lighting.js
@@ -0,0 +1,101 @@
+// Upgrade 3 - light and atmosphere: golden-hour grade, dithered vignette, warm sun
+// bloom from the top-left, drifting cloud shadows, additive glows, floating motes.
+import * as Phaser from 'phaser';
+import { DEPTH } from '../systems/depth.js';
+import { bayer, valueNoise } from './noise.js';
+
+function makeTex(scene, key, w, h, fn) {
+  if (scene.textures.exists(key)) return;
+  const tex = scene.textures.createCanvas(key, w, h);
+  const ctx = tex.getContext();
+  const img = ctx.createImageData(w, h);
+  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
+    const c = fn(x, y);
+    if (!c) continue;
+    const i = (y * w + x) * 4;
+    img.data[i] = c[0]; img.data[i + 1] = c[1]; img.data[i + 2] = c[2]; img.data[i + 3] = c[3];
+  }
+  ctx.putImageData(img, 0, 0);
+  tex.refresh();
+}
+
+export function createGlowTextures(scene) {
+  // Stepped (pixel-art) radial glow, white, tinted per use.
+  makeTex(scene, 'glow', 24, 24, (x, y) => {
+    const d = Math.hypot(x - 11.5, y - 11.5) / 12;
+    if (d > 1) return null;
+    const a = d < 0.3 ? 200 : d < 0.55 ? 120 : d < 0.8 ? 60 : bayer(x, y) < 0.5 ? 30 : 0;
+    return [255, 255, 255, a];
+  });
+}
+
+export class Lighting {
+  /** @param {Phaser.Scene} scene @param {{ width: number, height: number }} display @param {object} map */
+  constructor(scene, display, map) {
+    this.scene = scene;
+    const { width: w, height: h } = display;
+    createGlowTextures(scene);
+
+    makeTex(scene, 'vignette', w, h, (x, y) => {
+      const dx = (x - w / 2) / (w / 2);
+      const dy = (y - h / 2) / (h / 2);
+      const d = Math.hypot(dx * 0.85, dy);
+      let a = Math.max(0, (d - 0.6) / 0.62);
+      a = Math.min(1, a) ** 1.3 * 0.7;
+      return a > 0 ? [26, 12, 20, Math.round(a * 255)] : null;
+    });
+    makeTex(scene, 'sunwash', w, h, (x, y) => {
+      const d = Math.hypot(x / w, (y / h) * 0.7);
+      const a = Math.max(0, 1 - d * 1.25) ** 1.3;
+      return a > 0 ? [255, 196, 110, Math.round(a * 255)] : null;
+    });
+    makeTex(scene, 'cloud', 200, 110, (x, y) => {
+      const dx = (x - 100) / 100;
+      const dy = (y - 55) / 55;
+      const n = 1 - Math.hypot(dx, dy) + (valueNoise(x, y, 18, 4) - 0.5) * 0.7;
+      const a = Math.max(0, Math.min(1, (n - 0.2) / 0.35));
+      return a > 0 ? [20, 30, 60, Math.round(a * 255)] : null;
+    });
+
+    const fixed = (o) => o.setScrollFactor(0).setOrigin(0);
+    this.sun = fixed(scene.add.image(0, 0, 'sunwash')).setBlendMode(Phaser.BlendModes.ADD).setAlpha(0.08).setDepth(DEPTH.FX + 50);
+    this.vignette = fixed(scene.add.image(0, 0, 'vignette')).setDepth(DEPTH.FX + 51);
+
+    // Colour grade (WebGL only): a little more saturation and contrast.
+    try {
+      const cm = scene.cameras.main.postFX.addColorMatrix();
+      cm.saturate(0.15);
+      cm.contrast(0.05, true);
+      cm.brightness(0.95, true);
+    } catch { /* canvas renderer: skip */ }
+
+    const W = map.width * map.tileSize;
+    const H = map.height * map.tileSize;
+    this.clouds = [0, 1, 2].map((i) => scene.add.image((i * 330) % W, (i * 210 + 60) % H, 'cloud')
+      .setAlpha(0.08).setScale(1.4 + (i % 2) * 0.5).setDepth(DEPTH.FX - 10));
+    this.W = W;
+    this.H = H;
+
+    this.motes = scene.add.particles(0, 0, 'px', {
+      x: { min: 0, max: w }, y: { min: 0, max: h },
+      lifespan: 4000, speedY: { min: -6, max: -2 }, speedX: { min: 2, max: 8 },
+      scale: 0.5, alpha: { onEmit: () => 0, onUpdate: (p, k, t) => 0.7 * Math.sin(t * Math.PI) }, tint: 0xfff1b0,
+      frequency: 160, blendMode: 'ADD',
+    }).setScrollFactor(0).setDepth(DEPTH.FX + 49);
+  }
+
+  update(dt) {
+    for (const c of this.clouds) {
+      c.x += 7 * dt;
+      c.y += 2 * dt;
+      if (c.x > this.W + 200) c.x = -200;
+      if (c.y > this.H + 120) c.y = -120;
+    }
+  }
+}
+
+/** Adds an additive glow sprite. */
+export function addGlow(scene, tint, scale = 1, alpha = 0.55) {
+  createGlowTextures(scene);
+  return scene.add.image(0, 0, 'glow').setBlendMode(Phaser.BlendModes.ADD).setTint(tint).setScale(scale).setAlpha(alpha);
+}
diff --git a/src/client/gfx/noise.js b/src/client/gfx/noise.js
new file mode 100644
index 0000000..8ce00ed
--- /dev/null
+++ b/src/client/gfx/noise.js
@@ -0,0 +1,63 @@
+// Small deterministic noise helpers for baked pixel art.
+export function hash2(x, y, seed = 0) {
+  let h = (x * 374761393 + y * 668265263 + seed * 2147483647) | 0;
+  h = Math.imul(h ^ (h >>> 13), 1274126177);
+  h ^= h >>> 16;
+  return (h >>> 0) / 4294967295;
+}
+
+/** Smooth value noise in 0..1, `scale` = cell size in pixels. */
+export function valueNoise(x, y, scale, seed = 0) {
+  const fx = x / scale;
+  const fy = y / scale;
+  const x0 = Math.floor(fx);
+  const y0 = Math.floor(fy);
+  const tx = fx - x0;
+  const ty = fy - y0;
+  const sx = tx * tx * (3 - 2 * tx);
+  const sy = ty * ty * (3 - 2 * ty);
+  const a = hash2(x0, y0, seed);
+  const b = hash2(x0 + 1, y0, seed);
+  const c = hash2(x0, y0 + 1, seed);
+  const d = hash2(x0 + 1, y0 + 1, seed);
+  return a + (b - a) * sx + (c - a) * sy + (a - b - c + d) * sx * sy;
+}
+
+const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
+/** 4x4 ordered-dither threshold in 0..1. */
+export function bayer(x, y) {
+  return BAYER[(y & 3) * 4 + (x & 3)];
+}
+
+/** Separable box blur on a Float32Array (w*h), radius r, in place-ish (returns new). */
+export function boxBlur(src, w, h, r) {
+  const tmp = new Float32Array(w * h);
+  const out = new Float32Array(w * h);
+  const n = r * 2 + 1;
+  for (let y = 0; y < h; y++) {
+    let acc = 0;
+    for (let x = -r; x <= r; x++) acc += src[y * w + Math.min(w - 1, Math.max(0, x))];
+    for (let x = 0; x < w; x++) {
+      tmp[y * w + x] = acc / n;
+      const add = Math.min(w - 1, x + r + 1);
+      const sub = Math.max(0, x - r);
+      acc += src[y * w + add] - src[y * w + sub];
+    }
+  }
+  for (let x = 0; x < w; x++) {
+    let acc = 0;
+    for (let y = -r; y <= r; y++) acc += tmp[Math.min(h - 1, Math.max(0, y)) * w + x];
+    for (let y = 0; y < h; y++) {
+      out[y * w + x] = acc / n;
+      const add = Math.min(h - 1, y + r + 1);
+      const sub = Math.max(0, y - r);
+      acc += tmp[add * w + x] - tmp[sub * w + x];
+    }
+  }
+  return out;
+}
+
+export function hexRgb(hex) {
+  const n = parseInt(hex.slice(1), 16);
+  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+}
diff --git a/src/client/gfx/props.js b/src/client/gfx/props.js
new file mode 100644
index 0000000..7be755b
--- /dev/null
+++ b/src/client/gfx/props.js
@@ -0,0 +1,228 @@
+// Upgrade 2 - set dressing: swaying palm trees, the beached shipwreck at the spawn,
+// grass tufts, shells, starfish, driftwood, crates, barrels and bones.
+// Decorative only in this prototype (no collision).
+import { TILE } from '../../shared/content/tiles.js';
+import { tileAt } from '../../shared/sim/map.js';
+import { addOutline, createTextureFromGrid } from '../art/pixelArt.js';
+import { DEPTH } from '../systems/depth.js';
+import { hash2 } from './noise.js';
+
+const OUT = '#1a1212';
+
+function canvas(w, h) {
+  const g = Array.from({ length: h }, () => Array(w).fill(null));
+  const px = (x, y, c) => {
+    x = Math.round(x); y = Math.round(y);
+    if (x >= 0 && y >= 0 && x < w && y < h) g[y][x] = c;
+  };
+  const rect = (x0, y0, x1, y1, c) => { for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) px(x, y, c); };
+  const ellipse = (cx, cy, rx, ry, c) => {
+    for (let y = Math.floor(cy - ry); y <= Math.ceil(cy + ry); y++)
+      for (let x = Math.floor(cx - rx); x <= Math.ceil(cx + rx); x++)
+        if (((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 <= 1) px(x, y, typeof c === 'function' ? c(x, y) : c);
+  };
+  const line = (x0, y0, x1, y1, c, th = 1) => {
+    const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0)) * 2 + 1;
+    for (let i = 0; i <= n; i++) {
+      const x = x0 + ((x1 - x0) * i) / n;
+      const y = y0 + ((y1 - y0) * i) / n;
+      for (let k = 0; k < th; k++) px(x, y + k, c);
+    }
+  };
+  return { g, px, rect, ellipse, line, w, h };
+}
+
+function makeTextures(scene) {
+  if (scene.textures.exists('palmTrunk')) return;
+
+  // Palm trunk: curved, segmented, lit from the left
+  {
+    const c = canvas(12, 42);
+    for (let y = 0; y < 42; y++) {
+      const t = 1 - y / 41;
+      const cx = 4 + Math.round(t * t * 5);
+      const wdt = y > 34 ? 3 : 2;
+      for (let x = cx - wdt; x <= cx + wdt - 1; x++) {
+        let col = x === cx - wdt ? '#c88a50' : x >= cx + wdt - 2 ? '#6e3d1a' : '#a0612d';
+        if (y % 4 === 0) col = '#5a3216';
+        else if (y % 4 === 1 && x === cx - wdt) col = '#e0a868';
+        c.px(x, y, col);
+      }
+    }
+    createTextureFromGrid(scene, 'palmTrunk', addOutline(c.g, OUT));
+  }
+  // Palm crown: drooping fronds + coconuts
+  {
+    const c = canvas(50, 30);
+    const cx = 25;
+    const cy = 11;
+    const fronds = [[-2.9, 20], [-2.3, 17], [-1.6, 12], [-0.85, 17], [-0.25, 20], [0.4, 15], [2.7, 14], [3.35, 13]];
+    for (const [a, L] of fronds) {
+      for (let s = 0; s <= 1.0001; s += 0.02) {
+        const x = cx + Math.cos(a) * L * s;
+        const y = cy + Math.sin(a) * L * s * 0.55 + s * s * L * 0.55;
+        const th = s < 0.15 ? 2 : s < 0.75 ? 3 : 2;
+        for (let k = 0; k < th; k++) c.px(x, y + k, k === 0 ? '#5a9a48' : k === th - 1 ? '#2c5a2c' : '#3e7a3a');
+        if (s > 0.2 && Math.round(s * 50) % 3 === 0) { c.px(x, y + th, '#2c5a2c'); c.px(x + 1, y + th + 1, '#3e7a3a'); }
+        if (s > 0.3 && s < 0.8 && Math.round(s * 50) % 4 === 0) c.px(x, y - 1, '#7fbf5a');
+      }
+    }
+    c.ellipse(cx, cy, 5, 3, (x, y) => (y < cy - 1 ? '#7fbf5a' : y < cy + 1 ? '#5a9a48' : '#3e7a3a'));
+    for (const [ox, oy] of [[-3, 4], [1, 5], [4, 3]]) c.ellipse(cx + ox, cy + oy, 1.8, 1.8, (x, y) => (x < cx + ox && y < cy + oy ? '#a06a3c' : '#6b4020'));
+    createTextureFromGrid(scene, 'palmCrown', addOutline(c.g, OUT));
+  }
+  // Palm shadow (frond blob), soft
+  {
+    const c = canvas(44, 14);
+    c.ellipse(22, 7, 20, 5.5, 'rgba(40,24,16,0.26)');
+    for (const [ox, r] of [[-14, 5], [14, 5], [-7, 6], [8, 6]]) c.ellipse(22 + ox, 7 + (r - 5), r, 3, 'rgba(40,24,16,0.26)');
+    createTextureFromGrid(scene, 'palmShadow', c.g);
+  }
+  // Shipwreck: broken hull half-buried in sand, snapped mast, torn sail
+  {
+    const W = 84;
+    const c = canvas(W, 56);
+    const top = (x) => 22 + Math.round((x - 42) ** 2 / 180) + (x > 52 && x < 62 ? 4 + ((x * 7) % 3) : 0) + (x < 14 ? 2 : 0);
+    const bot = (x) => 40 + Math.round(Math.sin((Math.PI * (x - 4)) / 76) * 7);
+    for (let x = 4; x < 80; x++) {
+      for (let y = top(x); y <= bot(x); y++) {
+        const r = y - top(x);
+        let col = r < 2 ? '#c08048' : ((y >> 2) % 2 ? '#a0612d' : '#8a5126');
+        if (r >= 2 && r < 7 && x > 10 && x < 72) col = x % 9 === 0 ? '#7a4a26' : '#3a2414'; // inside, ribs
+        if (y === bot(x)) col = '#5a3216';
+        if ((x + y * 3) % 23 === 0 && r > 7) col = '#5a3216';
+        c.px(x, y, col);
+      }
+    }
+    // planks sticking up (broken ribs)
+    for (const [x, h] of [[18, 7], [27, 9], [36, 6], [66, 8]]) c.rect(x, top(x) - h, x + 1, top(x), '#7a4a26');
+    // snapped mast + sail
+    c.line(34, 30, 50, 4, '#5a3216', 2);
+    c.line(35, 30, 51, 4, '#8a5126', 1);
+    for (let y = 6; y < 26; y++) {
+      const x0 = 50 - (y - 6) * 0.45;
+      const x1 = x0 + 4 + (y - 6) * 0.9 - (y > 18 ? (y - 18) * 1.6 : 0);
+      for (let x = Math.round(x0) + 2; x < x1; x++) {
+        if (hash2(x, y, 3) < 0.06) continue; // holes
+        c.px(x, y, (x + y) % 7 === 0 ? '#c9b892' : y % 5 === 0 ? '#d9cba8' : '#efe3c4');
+      }
+    }
+    const og = addOutline(c.g, OUT);
+    // sand drifted against the hull (no outline, so it melts into the beach)
+    const sandC = canvas(86, 58);
+    sandC.g = og;
+    const mound = (cx, cy, rx, ry) => {
+      for (let y = Math.floor(cy - ry); y <= cy + ry; y++) for (let x = Math.floor(cx - rx); x <= cx + rx; x++) {
+        const d = ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2;
+        if (d > 1 || y < 0 || y >= og.length || x < 0 || x >= og[0].length) continue;
+        og[y][x] = d > 0.75 && hash2(x, y, 6) < 0.5 ? null : y < cy - ry * 0.3 ? '#f6dfa8' : '#e8c98a';
+      }
+    };
+    mound(22, 50, 20, 6);
+    mound(62, 51, 19, 5);
+    createTextureFromGrid(scene, 'wreck', og);
+  }
+  // Small props
+  const small = (key, w, h, draw, outline = OUT) => {
+    const c = canvas(w, h);
+    draw(c);
+    createTextureFromGrid(scene, key, outline ? addOutline(c.g, outline) : c.g);
+  };
+  for (let v = 0; v < 3; v++) {
+    small(`tuft${v}`, 9, 7, (c) => {
+      const blades = [[1, 3], [3, 6], [4, 4], [6, 5], [7, 2]].slice(v, v + 4);
+      for (const [x, h] of blades) for (let k = 0; k < h; k++) c.px(x + (k > h - 2 ? (v % 2 ? 1 : -1) : 0), 6 - k, k > h - 3 ? '#7fbf5a' : k > 1 ? '#5a9a48' : '#3e7a3a');
+    }, '#244a26');
+  }
+  small('shell', 4, 3, (c) => { c.rect(0, 1, 3, 2, '#f0a8a0'); c.px(1, 0, '#ffd6cf'); c.px(2, 0, '#ffd6cf'); c.px(1, 2, '#c97870'); }, null);
+  small('starfish', 5, 5, (c) => { c.rect(2, 0, 2, 4, '#ff8a50'); c.rect(0, 2, 4, 2, '#ff8a50'); c.px(1, 4, '#ff8a50'); c.px(3, 4, '#ff8a50'); c.px(2, 2, '#ffd0a0'); }, '#8a3a1a');
+  small('driftwood', 20, 5, (c) => { c.rect(0, 1, 19, 3, '#b99a78'); c.rect(0, 1, 19, 1, '#d8c2a2'); c.rect(4, 3, 16, 3, '#8f7458'); c.rect(14, 0, 16, 0, '#b99a78'); });
+  small('crate', 12, 12, (c) => {
+    c.rect(0, 0, 11, 3, '#c88a50'); c.rect(0, 4, 11, 11, '#a0612d');
+    c.rect(0, 4, 11, 4, '#6e3d1a'); c.line(0, 5, 11, 11, '#6e3d1a'); c.rect(0, 7, 11, 7, '#8a5126'); c.px(1, 1, '#e0a868');
+  });
+  small('barrel', 10, 13, (c) => {
+    c.ellipse(4.5, 2, 4.5, 2, '#c88a50'); c.rect(0, 2, 9, 11, '#a0612d'); c.rect(0, 2, 1, 11, '#c88a50'); c.rect(8, 2, 9, 11, '#6e3d1a');
+    c.rect(0, 4, 9, 4, '#4a4a55'); c.rect(0, 9, 9, 9, '#4a4a55'); c.ellipse(4.5, 2, 3, 1, '#5a3216');
+  });
+  small('bones', 9, 4, (c) => { c.rect(1, 1, 7, 1, '#f2ead8'); c.px(0, 0, '#f2ead8'); c.px(0, 2, '#f2ead8'); c.px(8, 0, '#f2ead8'); c.px(8, 2, '#f2ead8'); c.px(4, 2, '#c9bfa8'); }, '#6b5f50');
+}
+
+/**
+ * Places props deterministically around the arena.
+ * @param {Phaser.Scene} scene
+ * @param {{ width: number, height: number, tileSize: number, spawn: { x: number, y: number } }} map
+ */
+export function createProps(scene, map) {
+  makeTextures(scene);
+  const ts = map.tileSize;
+  const t = (x, y) => tileAt(map, x, y);
+  const sand = (x, y) => t(x, y) === TILE.SAND;
+  const near = (x, y, type, r) => {
+    for (let dy = -r; dy <= r; dy++) for (let dx = -r; dx <= r; dx++) if (t(x + dx, y + dy) === type) return true;
+    return false;
+  };
+  const sx = Math.floor(map.spawn.x / ts);
+  const sy = Math.floor(map.spawn.y / ts);
+  const objs = [];
+
+  // Shipwreck beside the spawn (the castaways' boat)
+  const wx = (sx - 11) * ts;
+  const wy = (sy + 2) * ts + 8;
+  objs.push(scene.add.image(wx + 30, wy + 2, 'palmShadow').setScale(2.2, 1.3).setDepth(DEPTH.SHADOW));
+  objs.push(scene.add.image(wx, wy, 'wreck').setOrigin(0.5, 1).setDepth(wy));
+  for (const [ox, oy, key, fl] of [[-46, 6, 'crate', false], [-34, 10, 'barrel', false], [44, 4, 'driftwood', true], [30, 16, 'crate', false], [-20, 22, 'driftwood', false]]) {
+    objs.push(scene.add.image(wx + ox + 2, wy + oy, 'shadow').setDepth(DEPTH.SHADOW));
+    objs.push(scene.add.image(wx + ox, wy + oy, key).setOrigin(0.5, 1).setFlipX(fl).setDepth(wy + oy));
+  }
+
+  // Palms near cliffs and water
+  const palms = [];
+  for (let y = 2; y < map.height - 2; y++) {
+    for (let x = 2; x < map.width - 2; x++) {
+      if (!sand(x, y) || !sand(x, y - 1)) continue;
+      if (!(near(x, y, TILE.CLIFF, 2) || near(x, y, TILE.WATER, 2))) continue;
+      if (near(x, y, TILE.ROCK, 1)) continue;
+      if (Math.abs(x - sx) < 5 && Math.abs(y - sy) < 4) continue;
+      if (Math.abs(x - (sx - 11)) < 5 && Math.abs(y - (sy + 2)) < 3) continue;
+      if (!near(x, y, TILE.CLIFF, 2) && hash2(x, y, 78) > 0.35) continue;
+      if (hash2(x, y, 77) > 0.25) continue;
+      if (palms.some((p) => Math.abs(p.x - x) + Math.abs(p.y - y) < 10)) continue;
+      palms.push({ x, y });
+    }
+  }
+  palms.forEach((p, i) => {
+    const bx = (p.x + 0.5) * ts + Math.round((hash2(p.x, p.y, 1) - 0.5) * 8);
+    const by = (p.y + 0.8) * ts;
+    const flip = hash2(p.x, p.y, 2) < 0.5;
+    objs.push(scene.add.image(bx + 14, by + 1, 'palmShadow').setDepth(DEPTH.SHADOW));
+    objs.push(scene.add.image(bx, by, 'palmTrunk').setOrigin(0.5, 1).setFlipX(flip).setDepth(by));
+    const topX = bx + (flip ? -4 : 4);
+    const crown = scene.add.image(topX, by - 41, 'palmCrown').setOrigin(0.5, 0.4).setFlipX(flip).setDepth(by + 0.5);
+    scene.tweens.add({ targets: crown, angle: { from: -2.5, to: 2.5 }, duration: 1600 + i * 97, yoyo: true, repeat: -1, ease: 'Sine.InOut', delay: i * 131 });
